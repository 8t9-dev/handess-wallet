{
  "name": "handshake-wallet",
  "version": "0.3.10",
  "description": "Handess Wallet - Handshake desktop wallet",
  "main": "./out/main/main.js",
  "homepage": "https://github.com/8t9-dev/handess-wallet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8t9-dev/handess-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/8t9-dev/handess-wallet/issues"
  },
  "author": {
    "name": "8t9.dev",
    "email": "8t9-dev@users.noreply.github.com"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package-win": "npm run build && electron-builder --win",
    "package-mac": "npm run build && electron-builder --mac",
    "package-linux": "npm run build && electron-builder --linux",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "arbiter:sign": "node scripts/escrow-arbiter-sign.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "index:build": "node scripts/build-hns-index.js"
  },
  "dependencies": {
    "@keep-network/electrum-client-js": "^0.2.0",
    "@noble/hashes": "^2.0.1",
    "@tanstack/react-table": "^8.11.0",
    "bip32": "^5.0.1",
    "bitcoinjs-lib": "^7.0.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.2.0",
    "ecpair": "^3.0.1",
    "electron-store": "^8.1.0",
    "extract-zip": "^2.0.1",
    "hs-client": "^0.0.13",
    "lucide-react": "^0.303.0",
    "nostr-tools": "^2.23.5",
    "qrcode.react": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "tailwind-merge": "^2.2.0",
    "tiny-secp256k1": "^2.2.4",
    "ws": "^8.21.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "hsd": "^8.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.2.0"
  },
  "build": {
    "appId": "com.handesswallet.app",
    "productName": "Handess Wallet",
    "artifactName": "Handess-Wallet-${version}.${ext}",
    "copyright": "Copyright © 2026 8t9.dev. Licensed under GPL-3.0-or-later.",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/hns-index.ndjson.gz",
        "to": "hns-index.ndjson.gz"
      }
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Finance",
      "maintainer": "8t9.dev <8t9-dev@users.noreply.github.com>",
      "synopsis": "Handshake desktop wallet",
      "description": "Handess Wallet is a desktop wallet for Handshake (HNS).",
      "icon": "resources/icon.png",
      "artifactName": "Handess-Wallet-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2"
      ]
    }
  }
}
